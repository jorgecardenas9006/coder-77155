<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
</head>
<body>
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header bg-warning text-dark">
                        <h3 class="mb-0">
                            <i class="bi bi-shield-check me-2"></i>{{title}}
                        </h3>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-success">
                            <h5><i class="bi bi-check-circle me-2"></i>Acceso Autorizado</h5>
                            <p class="mb-0">Bienvenido al panel de moderación, {{user.firstName}} {{user.lastName}}.</p>
                            <small class="text-muted">Tu rol: <strong>{{user.role}}</strong></small>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6">
                                <div class="card">
                                    <div class="card-body">
                                        <h6><i class="bi bi-chat-dots me-2"></i>Moderar Comentarios</h6>
                                        <p class="text-muted">Revisar y moderar comentarios de usuarios.</p>
                                        <button class="btn btn-outline-primary btn-sm">Acceder</button>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card">
                                    <div class="card-body">
                                        <h6><i class="bi bi-flag me-2"></i>Reportes</h6>
                                        <p class="text-muted">Revisar reportes de contenido inapropiado.</p>
                                        <button class="btn btn-outline-primary btn-sm">Acceder</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="mt-3">
                            <a href="/profile" class="btn btn-secondary">
                                <i class="bi bi-arrow-left me-2"></i>Volver al Perfil
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
