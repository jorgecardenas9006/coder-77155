<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
    <link href="/css/auth-error.css" rel="stylesheet">
</head>
<body>
    <div class="auth-error-container">
        <!-- Elementos decorativos de fondo -->
        <div class="background-shapes">
            <div class="shape shape-1"></div>
            <div class="shape shape-2"></div>
            <div class="shape shape-3"></div>
        </div>
        
        <div class="auth-error-card">
            <!-- Header con gradiente y efectos -->
            <div class="auth-error-header">
                <div class="warning-badge">
                    <div class="warning-icon-container">
                        <i class="bi bi-shield-exclamation"></i>
                        <div class="warning-pulse"></div>
                    </div>
                </div>
                <h2 class="warning-title">Acceso Restringido</h2>
                <p class="warning-subtitle">{{errorMessage}}</p>
            </div>
            
            <!-- Countdown mejorado -->
            <div class="countdown-section">
                <div class="countdown-wrapper">
                    <div class="countdown-circle">
                        <div class="countdown-progress">
                            <svg class="countdown-svg" viewBox="0 0 100 100">
                                <circle cx="50" cy="50" r="45" class="countdown-bg"></circle>
                                <circle cx="50" cy="50" r="45" class="countdown-progress-bar"></circle>
                            </svg>
                            <div class="countdown-number">
                                <span id="countdown">{{redirectDelay}}</span>
                            </div>
                        </div>
                    </div>
                    <div class="countdown-text">
                        <p class="countdown-main">Redirección automática</p>
                        <p class="countdown-sub">en <span id="countdown-text">{{redirectDelay}}</span> segundos</p>
                    </div>
                </div>
            </div>
            
            <!-- Información mejorada -->
            <div class="auth-error-info">
                <div class="info-card">
                    <div class="info-icon">
                        <i class="bi bi-info-circle"></i>
                    </div>
                    <div class="info-content">
                        <h6>¿Ya tienes cuenta?</h6>
                        <p>Inicia sesión para acceder a tu perfil personalizado</p>
                    </div>
                </div>
                
                <div class="info-card">
                    <div class="info-icon">
                        <i class="bi bi-person-plus"></i>
                    </div>
                    <div class="info-content">
                        <h6>¿Nuevo usuario?</h6>
                        <p>Crea una cuenta gratuita en segundos</p>
                    </div>
                </div>
            </div>
            
            <!-- Botones mejorados -->
            <div class="auth-error-actions">
                <a href="/login" class="btn btn-primary auth-error-btn primary-btn">
                    <div class="btn-content">
                        <i class="bi bi-box-arrow-in-right"></i>
                        <span>Iniciar Sesión</span>
                    </div>
                    <div class="btn-shine"></div>
                </a>
                <a href="/register" class="btn btn-outline-primary auth-error-btn secondary-btn">
                    <div class="btn-content">
                        <i class="bi bi-person-plus"></i>
                        <span>Crear Cuenta</span>
                    </div>
                </a>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        // Countdown automático
        let countdown = {{redirectDelay}};
        const countdownElement = document.getElementById('countdown');
        const countdownTextElement = document.getElementById('countdown-text');
        
        const timer = setInterval(() => {
            countdown--;
            countdownElement.textContent = countdown;
            countdownTextElement.textContent = countdown;
            
            if (countdown <= 0) {
                clearInterval(timer);
                window.location.href = '{{redirectUrl}}';
            }
        }, 1000);
        
        // Cancelar countdown si el usuario hace clic en algún botón
        document.querySelectorAll('.auth-error-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                clearInterval(timer);
            });
        });
    </script>
</body>
</html>