<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}} - Mi Aplicación</title>
    
    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <!-- CSS personalizado para error OAuth -->
    <link href="/css/login.css" rel="stylesheet">
</head>
<body>
    <div class="login-container">
        <!-- Elementos decorativos de fondo -->
        <div class="background-shapes">
            <div class="shape shape-1"></div>
            <div class="shape shape-2"></div>
            <div class="shape shape-3"></div>
        </div>
        
        <div class="login-card">
            <!-- Header -->
            <div class="login-header">
                <div class="login-icon-container">
                    <i class="bi bi-exclamation-triangle" style="color: #dc3545;"></i>
                    <div class="login-pulse" style="background: radial-gradient(circle, rgba(220, 53, 69, 0.3) 0%, transparent 70%);"></div>
                </div>
                <h2 class="login-title" style="background: linear-gradient(135deg, #dc3545 0%, #c82333 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">Error de Autenticación</h2>
                <p class="login-subtitle">Ocurrió un problema durante el proceso de autenticación</p>
            </div>
            
            <!-- Body -->
            <div class="login-body">
                <!-- Mensaje de error -->
                <div class="alert alert-danger" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    {{#if errorMessage}}
                        {{errorMessage}}
                    {{else}}
                        Error desconocido durante la autenticación con GitHub. Por favor, inténtalo de nuevo.
                    {{/if}}
                </div>
                
                <!-- Información adicional -->
                <div class="alert alert-info" role="alert">
                    <i class="bi bi-info-circle me-2"></i>
                    <strong>Posibles causas:</strong>
                    <ul class="mb-0 mt-2">
                        <li>Tu cuenta de GitHub no tiene un email público</li>
                        <li>No autorizaste el acceso a tu información</li>
                        <li>Problemas de conexión con GitHub</li>
                        <li>Ya existe una cuenta con este email</li>
                    </ul>
                </div>
                
                <!-- Botones de acción -->
                <div class="d-grid gap-2">
                    <a href="/login" class="btn btn-primary btn-login">
                        <i class="bi bi-arrow-left me-2"></i>
                        Volver al Login
                    </a>
                    <a href="/api/auth/github" class="btn btn-dark btn-github">
                        <i class="bi bi-github me-2"></i>
                        Intentar con GitHub Nuevamente
                    </a>
                    <a href="/" class="btn btn-outline-secondary">
                        <i class="bi bi-house me-2"></i>
                        Ir al Inicio
                    </a>
                </div>
                
                <!-- Enlaces adicionales -->
                <div class="text-center mt-4">
                    <p class="mb-2">¿Necesitas ayuda?</p>
                    <a href="/register" class="text-decoration-none">
                        <i class="bi bi-person-plus me-1"></i>
                        Crear Cuenta Manualmente
                    </a>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Bootstrap 5.3 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- JavaScript para manejo de errores -->
    <script>
        // Animación de entrada
        document.addEventListener('DOMContentLoaded', function() {
            const card = document.querySelector('.login-card');
            
            setTimeout(() => {
                card.classList.add('loaded');
            }, 100);
            
            // Auto-redirect después de 30 segundos si no hay interacción
            let redirectTimer = setTimeout(() => {
                if (confirm('¿Deseas volver al login automáticamente?')) {
                    window.location.href = '/login';
                }
            }, 30000);
            
            // Cancelar timer si hay interacción
            document.addEventListener('click', () => {
                clearTimeout(redirectTimer);
            });
        });
    </script>
</body>
</html>
